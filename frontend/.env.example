VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Optional. Enables the hero photo + flood-zone card photos via Unsplash's
# real API (with correct dynamic attribution). Free key, instant signup:
# https://unsplash.com/developers
# With this unset, the app shows an honest gradient/no-photo fallback instead
# of a fake or hotlinked placeholder image.
VITE_UNSPLASH_ACCESS_KEY=
